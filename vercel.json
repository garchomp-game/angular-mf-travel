{
  "framework": null,
  "installCommand": "bun install && cd app && bun install",
  "buildCommand": "cd app && bun run build",
  "outputDirectory": "app/dist/app/browser",
  "rewrites": [
    { "source": "/api/:path(.*)", "destination": "/api" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}

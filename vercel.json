{
  "framework": null,
  "installCommand": "cd app && bun install && cd ../server && bun install",
  "buildCommand": "cd app && bun run build",
  "outputDirectory": "app/dist/app/browser",
  "functions": {
    "api/index.ts": {
      "includeFiles": "server/**"
    }
  },
  "rewrites": [
    { "source": "/api/:path(.*)", "destination": "/api" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}

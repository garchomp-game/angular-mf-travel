{
  "name": "app",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "ng test --watch=false",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:parallel": "concurrently -g 'bun:typecheck' 'bun:lint' 'bun:format:check'",
    "check": "bun run check:parallel && bun run test:ci && bun run e2e",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "pw:install": "playwright install chromium"
  },
  "private": true,
  "packageManager": "bun@1.2.14",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@angular/service-worker": "^21.2.0",
    "@supabase/supabase-js": "^2.99.2",
    "@tailwindcss/postcss": "^4.2.1",
    "ngx-logger": "^5.0.12",
    "postcss": "^8.5.8",
    "rxjs": "~7.8.0",
    "tailwindcss": "^4.2.1",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-eslint/builder": "19",
    "@angular-eslint/eslint-plugin": "19",
    "@angular-eslint/eslint-plugin-template": "19",
    "@angular-eslint/template-parser": "19",
    "@angular/build": "^21.2.2",
    "@angular/cli": "^21.2.2",
    "@angular/compiler-cli": "^21.2.0",
    "@playwright/test": "^1.58.2",
    "@types/node": "^25.5.0",
    "angular-eslint": "19",
    "concurrently": "^9.2.1",
    "daisyui": "^5.5.19",
    "eslint": "9",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "typescript-eslint": "8",
    "vitest": "^4.0.8"
  }
}
